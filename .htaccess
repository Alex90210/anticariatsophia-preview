# ------------------------------------------------------------------
# Anticariat Sophia · .htaccess (draft 1)
# Ships inside dist/ (copied from public/) and is uploaded with the
# static build to the existing LiteSpeed host.
# Test on the host before going live: if the server answers 500,
# comment the blocks out one at a time.
# ------------------------------------------------------------------

# --- Charset --------------------------------------------------------
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .mjs .json .svg .txt .xml .webmanifest
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Directory listings: enable once the host confirms that Options
# overrides are allowed (otherwise this single line causes a 500).
# Options -Indexes

ErrorDocument 404 /404.html

# --- Redirects ------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Canonical host: force https + www in one hop (query string kept).
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.anticariatsophia\.ro$ [NC]
  RewriteRule ^ https://www.anticariatsophia.ro%{REQUEST_URI} [R=301,L]

  # 2. Old site pages -> sections of the new one.
  #    The trailing "?" drops the old query string; NE keeps "#" unescaped.
  RewriteRule ^contact\.html$ /#cum-ajungi? [R=301,L,NE]
  RewriteRule ^despre-noi\.html$ /#povestea? [R=301,L,NE]
  RewriteRule ^despre_comanda\.html$ /? [R=301,L]
  RewriteRule ^(cauta\.php|cautare_avansata\.html|cos\.html)$ /#rafturi? [R=301,L,NE]
  RewriteRule ^index\.php$ /? [R=301,L]

  # 3. Old RSS feed: gone for good.
  RewriteRule ^feed\.php$ - [G,L]

  # 4. Old catalog CATEGORY pages: /<nume>-pagina<N>.html (and plain /<nume>.html
  #    where such pages existed). Old names may contain spaces ("istorie romana",
  #    "auto- nave- avioane"), requested as %20 or "+". scripts/redirect-map.mjs
  #    generates one rule per old category from scripts/data/category-map.json,
  #    pointing it at the matching shelf /rafturi/<slug>/ (or at /#rafturi when
  #    no shelf fits), and writes those rules between the two markers below.
  #    Do not edit between the markers by hand; run `npm run redirects` instead.
  #    Shape of a generated rule (the path is URL-decoded before matching, so a
  #    space is matched with \s; \+ covers the "+" form, which is not decoded):
  #      RewriteRule ^istorie(?:\s|\+|%20)romana(?:-pagina[0-9]+)?\.html$ https://www.anticariatsophia.ro/rafturi/istorie-romana/? [R=301,L,NC]
  # BEGIN generated category redirects
  # 62 old categories, generated by scripts/redirect-map.mjs.
  # Do not edit by hand: re-run "npm run redirects" instead.
  RewriteRule ^agricultura-[\s+]zootehnie(-pagina[0-9]+)?\.html$ /rafturi/biologie/? [R=301,L,NC]
  RewriteRule ^antichitati(-pagina[0-9]+)?\.html$ /rafturi/carte-veche/? [R=301,L,NC]
  RewriteRule ^arta(-pagina[0-9]+)?\.html$ /rafturi/arta/? [R=301,L,NC]
  RewriteRule ^auto-[\s+]nave-[\s+]avioane(-pagina[0-9]+)?\.html$ /rafturi/tehnica/? [R=301,L,NC]
  RewriteRule ^biologie-[\s+]veterinara(-pagina[0-9]+)?\.html$ /rafturi/biologie/? [R=301,L,NC]
  RewriteRule ^calculatoare(-pagina[0-9]+)?\.html$ /rafturi/tehnica/? [R=301,L,NC]
  RewriteRule ^carte[\s+]veche(-pagina[0-9]+)?\.html$ /rafturi/carte-veche/? [R=301,L,NC]
  RewriteRule ^cd(-pagina[0-9]+)?\.html$ /rafturi/arta/? [R=301,L,NC]
  RewriteRule ^chimie(-pagina[0-9]+)?\.html$ /rafturi/chimie/? [R=301,L,NC]
  RewriteRule ^chirurgie(-pagina[0-9]+)?\.html$ /rafturi/medicina/? [R=301,L,NC]
  RewriteRule ^constructii(-pagina[0-9]+)?\.html$ /rafturi/tehnica/? [R=301,L,NC]
  RewriteRule ^constructii[\s+]masini(-pagina[0-9]+)?\.html$ /rafturi/tehnica/? [R=301,L,NC]
  RewriteRule ^critica-[\s+]memorii-[\s+]biografii(-pagina[0-9]+)?\.html$ /rafturi/critica-memorii-biografii/? [R=301,L,NC]
  RewriteRule ^dezvoltare[\s+]personala(-pagina[0-9]+)?\.html$ /rafturi/dezvoltare-personala/? [R=301,L,NC]
  RewriteRule ^dictionare(-pagina[0-9]+)?\.html$ /rafturi/dictionare-si-limbi-straine/? [R=301,L,NC]
  RewriteRule ^diverse(-pagina[0-9]+)?\.html$ /#rafturi? [R=301,L,NC,NE]
  RewriteRule ^drept(-pagina[0-9]+)?\.html$ /rafturi/drept/? [R=301,L,NC]
  RewriteRule ^economie(-pagina[0-9]+)?\.html$ /rafturi/economie/? [R=301,L,NC]
  RewriteRule ^electrice-[\s+]electronice(-pagina[0-9]+)?\.html$ /rafturi/tehnica/? [R=301,L,NC]
  RewriteRule ^filatelie(-pagina[0-9]+)?\.html$ /rafturi/carte-veche/? [R=301,L,NC]
  RewriteRule ^filosofie(-pagina[0-9]+)?\.html$ /rafturi/filosofie/? [R=301,L,NC]
  RewriteRule ^fizica(-pagina[0-9]+)?\.html$ /rafturi/fizica/? [R=301,L,NC]
  RewriteRule ^fotografie(-pagina[0-9]+)?\.html$ /rafturi/arta/? [R=301,L,NC]
  RewriteRule ^gastronomie(-pagina[0-9]+)?\.html$ /rafturi/gastronomie/? [R=301,L,NC]
  RewriteRule ^geografie(-pagina[0-9]+)?\.html$ /rafturi/geografie-si-calatorii/? [R=301,L,NC]
  RewriteRule ^istorie[\s+]romana(-pagina[0-9]+)?\.html$ /rafturi/istorie-romana/? [R=301,L,NC]
  RewriteRule ^istorie[\s+]universala(-pagina[0-9]+)?\.html$ /rafturi/istorie-universala/? [R=301,L,NC]
  RewriteRule ^limba[\s+]engleza(-pagina[0-9]+)?\.html$ /rafturi/dictionare-si-limbi-straine/? [R=301,L,NC]
  RewriteRule ^limba[\s+]franceza(-pagina[0-9]+)?\.html$ /rafturi/dictionare-si-limbi-straine/? [R=301,L,NC]
  RewriteRule ^limba[\s+]germana(-pagina[0-9]+)?\.html$ /rafturi/dictionare-si-limbi-straine/? [R=301,L,NC]
  RewriteRule ^limba[\s+]italiana(-pagina[0-9]+)?\.html$ /rafturi/dictionare-si-limbi-straine/? [R=301,L,NC]
  RewriteRule ^limba[\s+]romana(-pagina[0-9]+)?\.html$ /rafturi/dictionare-si-limbi-straine/? [R=301,L,NC]
  RewriteRule ^limba[\s+]rusa(-pagina[0-9]+)?\.html$ /rafturi/dictionare-si-limbi-straine/? [R=301,L,NC]
  RewriteRule ^limba[\s+]spaniola(-pagina[0-9]+)?\.html$ /rafturi/dictionare-si-limbi-straine/? [R=301,L,NC]
  RewriteRule ^limbi[\s+]straine[\s+]secundare(-pagina[0-9]+)?\.html$ /rafturi/dictionare-si-limbi-straine/? [R=301,L,NC]
  RewriteRule ^literatura[\s+]copii(-pagina[0-9]+)?\.html$ /rafturi/carte-pentru-copii/? [R=301,L,NC]
  RewriteRule ^literatura[\s+]romana(-pagina[0-9]+)?\.html$ /rafturi/literatura-romana/? [R=301,L,NC]
  RewriteRule ^literatura[\s+]universala(-pagina[0-9]+)?\.html$ /rafturi/literatura-universala/? [R=301,L,NC]
  RewriteRule ^logica(-pagina[0-9]+)?\.html$ /rafturi/filosofie/? [R=301,L,NC]
  RewriteRule ^love[\s+]story(-pagina[0-9]+)?\.html$ /rafturi/literatura-universala/? [R=301,L,NC]
  RewriteRule ^manga(-pagina[0-9]+)?\.html$ /rafturi/sf-si-fantasy/? [R=301,L,NC]
  RewriteRule ^matematica(-pagina[0-9]+)?\.html$ /rafturi/matematica/? [R=301,L,NC]
  RewriteRule ^media-[\s+]tv-[\s+]jurnalistica(-pagina[0-9]+)?\.html$ /rafturi/arta/? [R=301,L,NC]
  RewriteRule ^medicina[\s+]alternativa(-pagina[0-9]+)?\.html$ /rafturi/medicina/? [R=301,L,NC]
  RewriteRule ^medicina[\s+]generala(-pagina[0-9]+)?\.html$ /rafturi/medicina/? [R=301,L,NC]
  RewriteRule ^medicina[\s+]veterinara(-pagina[0-9]+)?\.html$ /rafturi/medicina/? [R=301,L,NC]
  RewriteRule ^mitologie-[\s+]populara(-pagina[0-9]+)?\.html$ /rafturi/religie-si-spiritualitate/? [R=301,L,NC]
  RewriteRule ^muzica(-pagina[0-9]+)?\.html$ /rafturi/arta/? [R=301,L,NC]
  RewriteRule ^paranormal-[\s+]yoga-[\s+]ocultism(-pagina[0-9]+)?\.html$ /rafturi/religie-si-spiritualitate/? [R=301,L,NC]
  RewriteRule ^pedagogie(-pagina[0-9]+)?\.html$ /rafturi/psihologie/? [R=301,L,NC]
  RewriteRule ^poezie(-pagina[0-9]+)?\.html$ /rafturi/poezie/? [R=301,L,NC]
  RewriteRule ^politica(-pagina[0-9]+)?\.html$ /rafturi/istorie-universala/? [R=301,L,NC]
  RewriteRule ^psihologie(-pagina[0-9]+)?\.html$ /rafturi/psihologie/? [R=301,L,NC]
  RewriteRule ^religie(-pagina[0-9]+)?\.html$ /rafturi/religie-si-spiritualitate/? [R=301,L,NC]
  RewriteRule ^sf-[\s+]politiste(-pagina[0-9]+)?\.html$ /rafturi/sf-si-fantasy/? [R=301,L,NC]
  RewriteRule ^sociologie(-pagina[0-9]+)?\.html$ /rafturi/filosofie/? [R=301,L,NC]
  RewriteRule ^spiritualitate(-pagina[0-9]+)?\.html$ /rafturi/religie-si-spiritualitate/? [R=301,L,NC]
  RewriteRule ^sport(-pagina[0-9]+)?\.html$ /#rafturi? [R=301,L,NC,NE]
  RewriteRule ^stomatologie(-pagina[0-9]+)?\.html$ /rafturi/medicina/? [R=301,L,NC]
  RewriteRule ^teatru-[\s+]cinema(-pagina[0-9]+)?\.html$ /rafturi/arta/? [R=301,L,NC]
  RewriteRule ^tehnica(-pagina[0-9]+)?\.html$ /rafturi/tehnica/? [R=301,L,NC]
  RewriteRule ^textile(-pagina[0-9]+)?\.html$ /rafturi/tehnica/? [R=301,L,NC]
  # END generated category redirects
  #    Any old category page not covered above lands on the shelves overview.
  RewriteRule ^[^/]+-pagina[0-9]+\.html$ /#rafturi? [R=301,L,NE]

  # 5. Old catalog BOOK pages: /<slug>__<autor>__<id>.html -> 410 Gone.
  #    The online catalog is closed and there is no per-book page to redirect
  #    to, so search engines are told to drop these URLs.
  RewriteRule ^[^/]+__[^/]+__[0-9]+\.html$ - [G,L]
</IfModule>

# --- Caching --------------------------------------------------------
<IfModule mod_headers.c>
  # Hashed build assets (Astro writes them under /_astro/ as name.<hash>.ext).
  # Their content never changes for a given name: cache for a year, immutable.
  <FilesMatch "\.[A-Za-z0-9_-]{8,}\.(css|js|mjs|woff2?|ttf|otf|png|jpe?g|gif|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML is revalidated on every visit so a new upload shows up at once.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
